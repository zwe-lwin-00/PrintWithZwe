# ── Shop catalog (Google Apps Script) ────────────────────
# Local dev uses mock data by default (no Google setup needed).
VITE_USE_MOCK=true
VITE_MOCK_ADMIN_PASSWORD=local-dev-password
VITE_MOCK_PRODUCTS_URL=/mock-products.json

# Production — set on Netlify after deploying Apps Script:
# VITE_USE_MOCK=false
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec

# ── Pricing (optional — overrides public/site-config.json at build time) ──
# VITE_PRICING_BASE_FEE=2000
# VITE_PRICING_MACHINE_RATE=1500
# VITE_PRICING_CURRENCY=MMK
# VITE_PRICING_LOCALE=en-MM
# VITE_PRICING_MATERIALS=[{"id":"pla","label":"PLA","ratePerGram":50}]

# ── Brand (optional) ─────────────────────────────────────
# VITE_BRAND_NAME=Print with Zwe
